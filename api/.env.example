# Local Postgres (see infra/docker-compose.yml)
DATABASE_URL=postgres://wowm:wowm@localhost:5432/wowm

# API
PORT=3003
HOST=0.0.0.0

# Auth
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# Sign in with Apple
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# App Store Server API (receipt verification, refund/revoke notifications)
APPLE_APP_STORE_KEY_ID=
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_PRIVATE_KEY_PATH=
APPLE_APP_STORE_BUNDLE_ID=

# Smarty (geocoding)
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Admin auth (D-01) — generate locally: openssl rand -hex 32
ADMIN_API_TOKEN=

# Smarty address standardization + geocoding (Product Specification.md section 17)
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Confidence threshold (0-1) above which a single-candidate geocode match is
# accepted as 'ok' rather than flagged 'low_confidence' (Product Specification.md section 17)
GEOCODE_CONFIDENCE_THRESHOLD=0.7

# CORS origin for the statically-exported admin app
ADMIN_ORIGIN=http://localhost:3000

# Vitest integration test database (api/test/setup.ts creates it on first run)
TEST_DATABASE_URL=postgres://wowm:wowm@127.0.0.1:5432/wowm_test
